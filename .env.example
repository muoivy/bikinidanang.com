# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Headless WordPress GraphQL endpoint
NEXT_PUBLIC_WP_GRAPHQL_URL=https://your-wordpress-site.com/graphql

# Optional: REST API base URL if needed for fallback
NEXT_PUBLIC_WP_REST_URL=https://your-wordpress-site.com/wp-json/wp/v2

# Optional: preview / protected content token
WP_API_TOKEN=

# Revalidation defaults (seconds)
NEXT_PUBLIC_REVALIDATE_DEFAULT=60
