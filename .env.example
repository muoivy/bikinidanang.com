# =========================================================================
# BIKINIDANANG.COM - ENVIRONMENT VARIABLES TEMPLATE
# =========================================================================

# 1. WORDPRESS HEADLESS CMS CONFIGURATION
# Đường dẫn đến Endpoint GraphQL của WordPress (Mặc định ở Local hoặc Production VPS)
NEXT_PUBLIC_WP_GRAPHQL_URL=http://bikinidanang.local/graphql

# Khóa bảo mật để Next.js có thể xem trước bài viết/sản phẩm ở chế độ Draft (Preview Mode)
WP_PREVIEW_SECRET=your_preview_secret_token_here

# 2. NEXTJS FRONTEND CONFIGURATION
# URL chạy cục bộ hoặc domain chính thức sau khi deploy (Phục vụ cấu hình SEO Metadata API)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. IMAGES & MEDIA OPTIMIZATION (Bổ sung thêm)
# Domain của WordPress để Next.js Image component cấp quyền tải và tối ưu hóa hình ảnh bikini
NEXT_PUBLIC_WP_URL=http://bikinidanang.local